+class Every:
+    def __init__(self, every):
+        self._every = every
+        self._last = None
+
+    def __call__(self, step):
+        if not self._every:
+            return 0
+        if self._last is None:
+            self._last = step
+            return 1
+        count = int((step - self._last) / self._every)
+        self._last += self._every * count
+        return count
+
