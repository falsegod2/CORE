+        post = {"stoch_s": stoch_s, "deter_s": prior["deter_s"], "stoch_z": stoch_z, "deter_z": prior["deter_z"]}
+        # 合并分布参数以便后续计算 KL (添加前缀防止冲突)
+        post.update({f"s_{k}": v for k, v in stats_s.items()})
+        post.update({f"z_{k}": v for k, v in stats_z.items()})
+        return post, prior
