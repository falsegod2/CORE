+        manager_action = manager_dist.mode() if not training else manager_dist.sample()
+        new_goal = feat.detach() + manager_action
+        goal = update_mask * new_goal + (1.0 - update_mask) * goal
+
+        worker_inp = torch.cat([feat, goal], dim=-1)
+
