 to_np = lambda x: x.detach().cpu().numpy()
 
 
+def _metric_to_float(value):
+    """Convert logger metrics to a Python float, including CUDA tensors.
+
+    Some losses/statistics are returned as torch.Tensor on CUDA. Passing them
+    directly to numpy triggers: "can't convert cuda tensor to numpy". This
+    helper keeps logging robust for scalars, numpy arrays, tensors, and lists.
+    """
+    if isinstance(value, torch.Tensor):
+        if value.numel() == 0:
+            return 0.0
+        value = value.detach().float()
+        return float(value.mean().cpu().item())
+    if isinstance(value, np.ndarray):
+        if value.size == 0:
+            return 0.0
+        return float(np.nanmean(value))
+    if isinstance(value, (list, tuple)):
+        vals = [_metric_to_float(v) for v in value if v is not None]
+        if len(vals) == 0:
+            return 0.0
+        return float(np.nanmean(vals))
+    try:
+        return float(value)
+    except (TypeError, ValueError):
+        arr = np.asarray(value)
+        if arr.size == 0:
+            return 0.0
+        return float(np.nanmean(arr))
+
+
