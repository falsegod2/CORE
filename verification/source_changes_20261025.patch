+            self.add("attention_entropy_normalized", normalized_entropy.sum().item(), normalized_entropy.numel())
+            self.add("attended_age_steps", (real_weights * age).sum().item(), real_mass.sum().item())
+            active_gate = gate.detach().float()[active]
